# Copy to backend/.env and fill in. backend/.env is git-ignored: never commit real keys or passwords.

# ---- Database (read by the Spring Boot backend when it runs outside Docker) ----
# Docker Compose maps its MySQL to host port 3307; use 3306 for a MySQL installed on your machine.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/mealmind?serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=your_db_user
SPRING_DATASOURCE_PASSWORD=your_db_password

# ---- AI agent (read by ai-service, not by the Java backend) ----
# Leave the key empty to run without the agent: the chat then uses the rule-based recommender only.
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Only used by ai-service's /ping check. The agent itself uses AGENT_MODEL (default: gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini
# Optional: full chat-completions URL of an OpenAI-compatible endpoint. Unset means api.openai.com.
# LLM_API_URL=https://api.openai.com/v1/chat/completions

# ---- Switches (optional; Docker Compose reads them when started with --env-file backend/.env) ----
# Let the chat call the AI agent. Spends real API credit (about $0.003 per recommendation). Default: false.
# MEALMIND_AGENT_ENABLED=true
# Agent loop: handwritten (default) or langgraph. Pause-and-ask / resume needs langgraph.
# AGENT_ENGINE=handwritten
