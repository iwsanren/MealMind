<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mealmind.mapper.FeedbackMapper">

    <resultMap id="FeedbackRowMap" type="com.mealmind.entity.FeedbackRow">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="sessionId" column="session_id"/>
        <result property="itemId" column="item_id"/>
        <result property="action" column="action"/>
        <result property="rating" column="rating"/>
        <result property="reason" column="reason"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.mealmind.entity.FeedbackRow"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO recommend_feedback (
        user_id, session_id, item_id, action, rating, reason, created_at
        ) VALUES (
        #{userId}, #{sessionId}, #{itemId}, #{action}, #{rating}, #{reason}, NOW()
        )
    </insert>

    <select id="findRecentByUser" resultMap="FeedbackRowMap">
        SELECT id, user_id, session_id, item_id, action, rating, reason, created_at
        FROM recommend_feedback
        WHERE user_id = #{userId}
        AND item_id IS NOT NULL
        ORDER BY created_at DESC, id DESC
        LIMIT #{limit}
    </select>

</mapper>
