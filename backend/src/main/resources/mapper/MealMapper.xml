<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mealmind.mapper.MealMapper">

    <resultMap id="MealItemResultMap" type="com.mealmind.entity.MealItem">
        <id property="id" column="id"/>
        <result property="sourceType" column="source_type"/>
        <result property="ownerUserId" column="owner_user_id"/>
        <result property="name" column="name"/>
        <result property="price" column="price"/>
        <result property="tagsJson" column="tags"/>
    </resultMap>

    <insert id="insert" parameterType="com.mealmind.entity.MealItem"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO meal_item (source_type, owner_user_id, name, price, tags)
        VALUES (#{sourceType}, #{ownerUserId}, #{name}, #{price}, #{tagsJson})
    </insert>

    <select id="findPersonalMeals" resultMap="MealItemResultMap">
        SELECT id, source_type, owner_user_id, name, price, tags
        FROM meal_item
        WHERE source_type = 'PERSONAL' AND owner_user_id = #{ownerUserId}
        ORDER BY id
    </select>
</mapper>
